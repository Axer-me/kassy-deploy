# SMTP-настройки (пример для Yandex)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@yandex.ru
SMTP_PASS=your_app_password

# От кого приходит письмо
SMTP_FROM=Альфа-Банк <your@yandex.ru>

# Supabase — для сохранения заявок в базу данных
# Найти в: Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...  # service_role key (не anon!)

# Порт локального сервера
PORT=3456
